# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database: MongoDB Atlas
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=capstonex

# Authentication
# Secret key for signing JWT tokens
JWT_SECRET=super_secret_ai_project_mentor_jwt_key_2026
JWT_EXPIRES_IN=7d

# AI Provider: Groq Cloud API
# Get your free API key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Render Keep-Alive Configuration (Prevents Render free tier from sleeping)
# Render automatically sets RENDER_EXTERNAL_URL (e.g. https://capstonexai.onrender.com)
RENDER_EXTERNAL_URL=
KEEP_ALIVE_INTERVAL_MINUTES=10

